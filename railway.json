{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "nixpacksPlan": {
      "apt_packages": ["libatomic1"],
      "install": ["node"]
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10,
    "startCommand": "node server.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60
  }
}
